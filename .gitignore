# Environment and secrets
.env
*.env
.secrets

# Claude Code local settings
.claude/settings.local.json
.claude/plans/
.claude/projects/
.claude/scheduled_tasks.lock
.serena/
docs/plans/
docs/superpowers/

# Vendored packages captured from a BERDL pod (see issue #316).
# berdl_remote and spark_connect_remote are pinned from github.com/BERDataLakehouse,
# which returns 404, so these local copies cannot be re-fetched. They are third-party
# code and this repository is public: never commit them.
vendor/
*.tgz

# Large data files
*.npy
*.pkl
*.parquet
*.h5
*.hdf5

# Large CSVs (keep small ones)
supplementary_table_s1_all_species.csv

# Jupyter checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Tree files (large)
*.tree

# Executed notebooks (keep source, ignore large executed versions)
*_executed.ipynb

# Temporary files
tmp/
*.tmp
*.temp

# Data directories (keep structure, ignore contents)
data/**/*.csv
data/**/*.npy
data/**/*.pkl
!data/.gitkeep

# Generated by scripts/berdl_inventory.py — full per-tenant report
data/berdl_inventory.md
# Generated by scripts/berdl_inventory.py — local inventory cache (per env + token)
data/berdl_inventory_cache.json

# MGnify ingest - ignore all downloaded data, keep scripts
data/mgnify_ingest/metadata/
data/mgnify_ingest/protein_db/
data/mgnify_ingest/genome_catalogues/
data/mgnify_ingest/sourmash_dbs/
data/mgnify_ingest/logs/
projects/*/data/**/*.csv
projects/*/data/**/*.tsv
projects/*/data/**/*.npy
projects/*/data/**/*.pkl
projects/*/data/**/*.fasta
projects/*/data/**/*.fna
projects/*/data/**/*.faa
projects/*/data/**/*.fa
!projects/*/data/.gitkeep
projects/*/user_data/**/*.csv
projects/*/user_data/**/*.tsv
projects/*/user_data/**/*.npy
projects/*/user_data/**/*.pkl
projects/*/user_data/**/*.sqlite
projects/*/user_data/**/*.db
projects/*/user_data/**/*.xlsx
!projects/*/user_data/.gitkeep

# Live dashboard — generated snapshot and launcher log, per project.
# WORKLOG.md and plan_deviations.jsonl stay tracked: they are provenance.
projects/*/dashboard.html
# Session pin marker — see PROJECT.md "Telling the tools which project"
projects/*/.beril-pin
projects/*/.dash.log
# Whether the agent is blocked on a human right now — true for seconds, and
# only ever about the machine it was written on.
projects/*/.agent-state.json
projects/*/.agent-state.json.tmp
# Passive per-session runtime history. Non-authoritative (see
# docs/provenance-and-trust.md) and machine-local in content: shell user, ORCID,
# session id, model. Never committed on any branch in this repo's history, so
# ignoring it preserves the de-facto behaviour and stops a fresh clone showing an
# untracked file after the SessionStart hook writes one.
projects/*/runtime.json

# UI application
ui/data/cache.json
ui/data/indexdir/
ui/user_projects/

# Chat component build output (generated from ui/components/chat/)
ui/app/static/chat/

# Frontend build artifacts & deps
node_modules/
ui/components/*/dist/
.vite/

# Python virtual environments
.venv/
.venv-berdl/
venv/

.stignore
.stfolder/

# Python test results
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
*.uc

graphify-out/

# OpenViking
knowledge/workspace
knowledge/ov.conf
knowledge/openviking/ov.conf
knowledge/openviking/gcp-key.json

# Superpowers brainstorm session artifacts
.superpowers/
